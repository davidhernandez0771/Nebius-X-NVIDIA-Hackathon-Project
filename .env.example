# Copy this file to .env and fill in your key. Never commit .env.
# Get a key at https://tokenfactory.nebius.com (API keys section).
NEBIUS_API_KEY=

# Optional overrides (defaults shown). Leave blank to use defaults.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_MODEL_NANO=nvidia/Nemotron-3_5-Lightning
# NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Spend log (optional). Defaults to ./usage_log.jsonl in the folder you run from.
# If you work in several git worktrees, point them all at the SAME file so the
# $25 Nebius budget is tracked in one place (total_spend() and vision_eval.py's
# budget guard read it). "~" is expanded. Example:
# USAGE_LOG_PATH=~/shared_usage_log.jsonl
